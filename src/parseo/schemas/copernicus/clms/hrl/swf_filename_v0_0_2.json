{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_id": "copernicus:clms:hrl:swf",
  "schema_version": "0.0.2",
  "status": "current",
  "description": "CLMS High Resolution Layer Small Landscape Features product filename (extension optional).",
  "fields": {
    "programme": {
      "type": "string",
      "enum": [
        "CLMS"
      ],
      "description": "Copernicus Land Monitoring Service programme identifier"
    },
    "product": {
      "type": "string",
      "enum": [
        "HRLSLF"
      ],
      "description": "Product family identifier"
    },
    "variable": {
      "type": "string",
      "pattern": "^[A-Z]{2,3}$",
      "description": "Layer code (e.g., SFW, CM, FM, WVL, SWF)"
    },
    "temporal_coverage": {
      "type": "string",
      "pattern": "^S\\d{4}$",
      "description": "Temporal coverage token (e.g., S2021)"
    },
    "resolution": {
      "type": "string",
      "pattern": "^(?:R(?:5|10|20|100)m|VEC)$",
      "description": "Spatial resolution"
    },
    "tile_id": {
      "title": "INSPIRE ETRS89-LAEA Grid",
      "type": "string",
      "pattern": "^[EW]\\d{2,3}[NS]\\d{2,3}$",
      "description": "Regional LAEA grid tile identifier (2- or 3-digit coordinates)"
    },
    "epsg_code": {
      "type": "string",
      "pattern": "^\\d{5}$",
      "description": "EPSG code of the product grid"
    },
    "version": {
      "type": "string",
      "pattern": "^[Vv]\\d{2}$",
      "description": "Product version"
    },
    "release": {
      "type": "string",
      "pattern": "^[Rr]\\d{2}$",
      "description": "Release identifier"
    },
    "production_date": {
      "type": "string",
      "pattern": "^\\d{8}$",
      "description": "Production date (YYYYMMDD)"
    },
    "extension": {
      "type": "string",
      "enum": [
        "tif",
        "gpkg"
      ],
      "description": "File extension without leading dot"
    }
  },
  "template": "{programme}_{product}_{variable}_{temporal_coverage}_{resolution}_{tile_id}_{epsg_code}_{version}_{release}_{production_date}[.{extension}]",
  "examples": [
    "CLMS_HRLSLF_SFW_S2021_R5m_E34N27_03035_v01_r01_20260521.tif",
    "CLMS_HRLSLF_SFW_S2021_R100m_E36N31_03035_v01_r01_20260521.tif",
    "CLMS_HRLSLF_CM_S2021_R5m_E36N31_03035_v01_r01_20260521.tif",
    "CLMS_HRLSLF_FM_S2021_R5m_E36N31_03035_v01_r01_20260521.tif",
    "CLMS_HRLSLF_WVL_S2018_R5m_E26N17_03035_V01_R02_20260407.tif",
    "CLMS_HRLSLF_SWF_S2021_VEC_E26N17_03035_V01_R02_20260407.gpkg"
  ]
}
